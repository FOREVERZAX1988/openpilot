Import('env')

# params.cc #includes params_keys.h, whose whole key registry is one big
# constexpr std::unordered_map initializer, and that one translation unit is the
# heaviest thing in the tree: on this C3 (3.6 GB RAM, ~1.9 GB available offroad)
# clang++ peaks at 1.9 GB RSS with -O1 -g and gets SIGKILLed by lowmemorykiller
# at -O2 -g (dmesg: "Killing 'clang++' ... to free 1817860kB on behalf of
# 'openpilot.sunny'"), so plain `scons` could never rebuild the params key table
# here. -O0 peaks at 261 MB in 34 s and survives next to the running daemons.
# Pin only this TU to -O0: it is a registry lookup + file/zmq I/O, not hot code,
# and ABI/semantics are identical. Notes + numbers:
# ai/docs/libparams_c_rebuild_recipe_20261021.md
_params_env = env.Clone(CCFLAGS=[flag for flag in env["CCFLAGS"] if flag != "-O2"] + ["-O0"])
_params_obj = _params_env.Object("params.o", "params.cc")

common_libs = [
  'swaglog.cc',
  'util.cc',
  'ratekeeper.cc',
  'yuv.cc',
]

_common = env.Library('common', common_libs + [_params_obj], LIBS="json11")
Export('_common')

params_python = env.SharedLibrary('params_c', 'params_c.cc', LIBS=[_common, 'zmq', 'json11'])
common_python = [params_python]
Export('common_python')

if GetOption('extras'):
  env.Program('tests/test_swaglog', 'tests/test_swaglog.cc', LIBS=[_common, 'json11', 'zmq', 'pthread'])
