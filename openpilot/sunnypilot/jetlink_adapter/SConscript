# The comma-side warp jetlink's large model runs, as a build product.
#
# jetlink's frame loop runs openpilot's own warp since "run modeld's own warp,
# not one jetlink builds" (jetlink 0f87696): a pickle holding {'run': a captured
# TinyJit, 'input_specs': {...}} whose two inputs are both camera frames as one
# (2, frame size) uint8 input_frame and their transforms as one (2, 3, 3)
# float32 M_inv, out the (2, 6, model_h // 2, model_w // 2) frame the link
# sends. Upstream openpilot compiles that pickle with tinygrad's
# examples/openpilot/compile_warp.py (--frames 2 --layout yuv420) inside
# modeld/SConscript; this fork's tinygrad predates that script and this fork's
# modeld runs no warp of its own, so the same artifact is built here by
# openpilot/sunnypilot/jetlink_adapter/warp_build.py, over the fork's own graph
# (compile_modeld.make_frame_prepare, the same perspective warp) and the same
# nv12 layout a camera hands out.
#
# Built like dm_warp_*.pkl in modeld/SConscript: launch_chffrplus.sh runs
# build.py before manager, so a tinygrad bump has a fresh warp before ignition,
# and a prebuilt release carries one for every camera it installs on. Nothing
# compiles a warp at runtime; a device without one stays on the small model and
# the offroad alert says why.
#
# Two per camera, one build apart: the plain warp, which USB runs, and the
# lossless build beside it (warp_build --lossless, jetlink's own name rule),
# which carries the frame's MED errors as a second output. Only the Wi-Fi link
# loads that one: it sends the frame packed instead of raw, about half the
# bytes, which is what a radio needs (jetlink.lossless). A jetlink without
# jetlink.openpilot.lossless gets the plain warp alone.
import glob
import os

from SCons.Script import Action

Import('env', 'arch', 'camera_configs')

basedir = env.Dir("#").abspath
builder = os.path.join(basedir, 'openpilot', 'sunnypilot', 'jetlink_adapter', 'warp_build.py')
# jetlink's own loader: what the pickle has to hold to be loaded, so a bent
# expectation rebuilds the artifact rather than failing on the drive
jetlink_warp = env.Dir("#jetlink_repo").abspath + '/jetlink/openpilot/warp.py'

# comma GPU only: the pickle is captured against Device.DEFAULT and only modeld
# on the device loads one
if arch == 'comma_arm64':
  from openpilot.common.transformations.model import MEDMODEL_INPUT_SIZE
  from openpilot.sunnypilot import jetlink_adapter

  # the flags modeld/SConscript compiles the models with: what the warp's
  # inputs are captured on has to be what the running modeld passes
  tg_flags = 'DEV=QCOM IMAGE=1 FLOAT16=1 NOLOCALS=1 JIT_BATCH_SIZE=0 OPENPILOT_HACKS=1'

  # camera_configs is modeld/SConscript's: a source build's own camera, or every
  # one a prebuilt installs on. The comma four runner's release once gave a 3X
  # no warp and the small model for good
  model_w, model_h = MEDMODEL_INPUT_SIZE
  prebuilt = bool(os.getenv('PREBUILT_ALL_CAMERAS'))

  tinygrad_files = ["#" + x for x in glob.glob(env.Dir("#tinygrad_repo").relpath + "/**",
                                               recursive=True, root_dir=basedir)
                    if 'pycache' not in x and os.path.isfile(os.path.join(basedir, x))]
  script_files = [
    File("#openpilot/sunnypilot/jetlink_adapter/warp_build.py"),  # the capture, and the specs it writes
    File("#openpilot/sunnypilot/jetlink_adapter/__init__.py"),    # where the warp goes, and where modeld looks
    File("#openpilot/selfdrive/modeld/compile_modeld.py"),        # comma's warp graph
    File("#openpilot/system/camerad/cameras/nv12_info.py"),       # the frame layout the graph indexes
    File(jetlink_warp),                                           # the shape jetlink's loader insists on
  ]

  # jetlink's lossless frames (jetlink.openpilot.lossless, jetlink.lossless):
  # the errors are what the Wi-Fi link packs, so the build makes that warp
  # wherever the submodule has the module. An empty jetlink_repo, or one from
  # before it, gets the plain warp alone and the link goes raw
  jetlink_lossless = File("#jetlink_repo/jetlink/openpilot/lossless.py")
  # without the submodule there is no link at all, and no warp to build for it
  build_warps = os.path.isfile(jetlink_warp)
  build_lossless = build_warps and os.path.isfile(jetlink_lossless.abspath)

  for cam_w, cam_h in camera_configs:
    # the targets are the paths modeld opens, from the adapter, so the two
    # cannot drift; the lossless one is where jetlink looks for it beside the plain
    builds = [(str(jetlink_adapter.warp_path(cam_w, cam_h, model_w, model_h)), '', [])]
    if build_lossless:
      builds.append((str(jetlink_adapter.lossless_warp_path(cam_w, cam_h, model_w, model_h)), ' --lossless',
                     [jetlink_lossless]))
    # the build's own root on the path: the builder imports openpilot and the
    # tinygrad symlink beside it, and a prebuilt build may not run from the tree.
    # The submodule as well, under which jetlink itself imports: the root beside
    # it carries `jetlink` only as a symlink a prebuilt runner does not make
    path = [env['ENV'].get('PYTHONPATH', ''), basedir, env.Dir("#jetlink_repo").abspath]
    lenv = env.Clone(ENV={**env['ENV'], 'PYTHONPATH': os.pathsep.join(path)})
    for pkl, flag, extra in builds if build_warps else []:
      # On a source build '-' ignores the exit status: every device builds this,
      # link on or not, so a failed compile must not fail the build. It leaves no
      # pickle, modeld stays on the small model, the link's alert says why, and
      # the next build tries again. A release fails here instead: it installs on
      # devices that never build
      cmd = (f'{"-" if not prebuilt else ""}{tg_flags} python3 -m openpilot.sunnypilot.jetlink_adapter.warp_build '
             f'--camera {cam_w}x{cam_h} --model {model_w}x{model_h} --output {pkl}{flag}')
      lenv.Command(pkl, tinygrad_files + script_files + extra, Action(cmd, "  [JETLINK WARP] $TARGET"))
