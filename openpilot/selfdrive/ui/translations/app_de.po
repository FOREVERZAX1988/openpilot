msgid "Macan Accel Deadzone (m/s^2)"
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Accel Deadzone Enable"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Accel Deadzone Enable: master switch. Off = deadzone fully disabled (value kept but ignored)."
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Accel Deadzone: zeroes aTarget inside +/- this value to filter MPC jitter (m/s^2). 0 = off."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
msgid "Macan Accel Jerk Limit"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Accel Jerk Limit: limits how fast the acceleration request can change (m/s^3). Lower = smoother (gentler transitions, less surge); higher = more responsive. 0 = off (no limit). Decel (braking) is allowed 2.2x faster for safety. Takes effect within 1s."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Accel Limit (m/s^2)"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Accel Limit: clamps the acceleration request magnitude (m/s^2). 0 = factory curve."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
msgid "Macan Corner Accel Limit"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Corner Accel Limit: when enabled, the steering angle (>5 deg) linearly reduces the longitudinal acceleration cap (down to 0.3x at 30+ deg) - prevents \"accelerating before the wheel is straight\". Field data: 62% of accel events happen with |angle|>8 deg. Takes effect immediately, no restart needed."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Cruise Coast Band (m/s)"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Cruise Coast Band (m/s): coasting zone width around the set speed. 0.4 (~1.4 km/h) recommended. Larger = more gliding but slower speed recovery after hills. 0 = off."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Cruise Coast Enable"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Cruise Coast Enable: when ON, within +/-band of the set speed the acceleration request is 0 (coast/glide), so the car naturally settles instead of oscillating accelerate-brake (fixes surge/rocking: the accel request was non-zero 81% of the time in field data, vEgo swung +/-8 km/h around the set speed). Outside the band, deadband control applies (smoother corrections). Takes effect immediately."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Distance Sync Direction"
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
msgid "Macan Slope Comp Unlimited"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Slope Comp Unlimited (sub-option): when Slope Compensation is ON, this removes the stock torque cap (option 2: min(max(stock_mom, 200))), giving small slopes room to act. When OFF, the stock cap applies (option 1: min(stock_mom))."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
msgid "Macan Slope Compensation"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Slope Compensation: when enabled, the IMU slope signal adds g*sin(slope) to the acceleration request - more torque uphill with a positive Verz request (declared acceleration, ~4.2*sin(slope)), a brief positive Verz ramp (+1.285 over 180ms) when overriding a deceleration with the gas pedal, and a brake tap downhill (prevents forward lurch). Default off = stock behavior. Onroad cycle restart is requested after toggling."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
msgid "Macan Stop and Go"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Stop and Go: when enabled, the vision model decides when to start, and openpilot sends the RESUME signal to release the stock parking hold (with a chime). When disabled, gently press the gas or SET/RESUME to resume (stock behavior)."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Verz Bridge"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Verz Bridge: when ON, the bridge applies a percentage-based ramp to smooth the requested deceleration (step = 1.25% x |verz|) - softens abrupt OP-initiated braking and kills the breath/pulse. When OFF, the verz request passes through un-smoothed (one-frame, no ramp). Deep braking (<= -1.5) and OEM brake requests still pass through either way for safety."
msgstr ""

