#: selfdrive/ui/mici/layouts/settings/toggles.py
msgid "Macan Slope Compensation"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Slope Compensation: when enabled, the IMU slope signal adds g*sin(slope) to the acceleration request - more torque uphill with a positive Verz request (declared acceleration, ~4.2*sin(slope)), a brief positive Verz ramp (+1.285 over 180ms) when overriding a deceleration with the gas pedal, and a brake tap downhill (prevents forward lurch). Default off = stock behavior. Onroad cycle restart is requested after toggling."
msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
msgid "Macan Stop and Go"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
