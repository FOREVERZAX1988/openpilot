msgstr ""

#: selfdrive/ui/mici/layouts/settings/toggles.py
#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Verz Bridge"
msgstr ""

#: selfdrive/ui/sunnypilot/layouts/settings/vehicle/brands/volkswagen.py
msgid "Macan Verz Bridge: when ON, the bridge applies a percentage-based ramp to smooth the requested deceleration (step = 1.25% x |verz|) - softens abrupt OP-initiated braking and kills the breath/pulse. When OFF, the verz request passes through un-smoothed (one-frame, no ramp). Deep braking (<= -1.5) and OEM brake requests still pass through either way for safety."
msgstr ""

